{
	dynamic_dns {
		provider netcup {
			customer_number {$NETCUP_CUSTOMER_NUMBER}
			api_key {$NETCUP_API_KEY}
			api_password {$NETCUP_API_PASSWORD}
		}

		# Optional second zone. Empty ZONE2/SUBDOMAINS2 leaves a blank line.
		domains {
			{$ZONE} {$SUBDOMAINS}
			{$ZONE2} {$SUBDOMAINS2}
		}

		versions ipv4
		check_interval 5m
		ttl 5m
	}
}
